msgstr "Masalah belum selesai? Saya buatkan laporan ke tim TI. Ringkasan percakapan ini akan dilampirkan, jadi Anda tidak perlu menjelaskan ulang."

msgid "I could not find the answer yet. Shall I create a report for the IT team? This conversation summary will be attached."
msgstr "Saya belum menemukan jawabannya. Mau saya buatkan laporan ke tim TI? Ringkasan percakapan ini akan dilampirkan."

msgid "Yes, create report"
msgstr "Ya, buat laporan"

msgid "No, thank you"
msgstr "Tidak, terima kasih"

msgid "Summary to be attached"
msgstr "Ringkasan yang dilampirkan"

# Deteksi pola insiden (Fase 6)
msgid "Incident pattern"
msgid_plural "Incident patterns"
msgstr[0] "Pola insiden"

msgid "Incident pattern: %s"
msgstr "Pola insiden: %s"

msgid "HaloSIS: detect incident patterns from similar new tickets"
msgstr "HaloSIS: deteksi pola insiden dari tiket baru yang mirip"

msgid "Incident pattern detection is disabled in the HaloSIS configuration."
msgstr "Deteksi pola insiden dimatikan di konfigurasi HaloSIS."


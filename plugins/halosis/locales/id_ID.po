# Halaman konfigurasi
msgid "Demo mode is active"
msgstr "Mode demo aktif"

msgid "No API key is stored. All AI features use deterministic sample answers so they can be demonstrated without internet access."
msgstr "Belum ada kunci API yang tersimpan. Semua fitur AI memakai jawaban contoh yang deterministik sehingga tetap dapat didemokan tanpa akses internet."

msgid "Connected to AI provider"
msgstr "Terhubung ke penyedia AI"

msgid "AI calls are made from the GLPI server. The API key is never sent to the browser."
msgstr "Pemanggilan AI dilakukan dari server GLPI. Kunci API tidak pernah dikirim ke peramban."

msgid "AI provider"
msgstr "Penyedia AI"

msgid "Provider"
msgstr "Penyedia"

msgid "API key"
msgstr "Kunci API"

msgid "An API key is stored (encrypted). Leave empty to keep it."
msgstr "Kunci API sudah tersimpan (terenkripsi). Biarkan kosong untuk mempertahankannya."

msgid "Leave empty to use demo mode."
msgstr "Biarkan kosong untuk memakai mode demo."

msgid "Delete stored API key"
msgstr "Hapus kunci API yang tersimpan"

msgid "Return to demo mode."
msgstr "Kembali ke mode demo."

msgid "Model"
msgstr "Model"

msgid "Model ID at the provider, e.g. claude-opus-5-5."
msgstr "ID model di penyedia, misalnya claude-opus-5-5."

msgid "API base URL"
msgstr "URL dasar API"

msgid "Optional. Fill in for an OpenAI-compatible gateway or proxy; leave empty for the provider default."
msgstr "Opsional. Isi untuk gateway atau proxy yang kompatibel dengan OpenAI; kosongkan untuk memakai alamat bawaan penyedia."

msgid "Timeout (seconds)"
msgstr "Batas waktu (detik)"

msgid "If the AI does not answer in time, tickets are still saved normally without a suggestion."
msgstr "Jika AI tidak menjawab tepat waktu, tiket tetap tersimpan seperti biasa tanpa saran."

msgid "Triage"
msgstr "Triase"

msgid "Confidence threshold"
msgstr "Ambang keyakinan"

msgid "Suggestions at or above this confidence are marked “Recommended”."
msgstr "Saran dengan keyakinan sama dengan atau di atas ambang ini diberi tanda “Disarankan”."

msgid "AI features"
msgstr "Fitur AI"


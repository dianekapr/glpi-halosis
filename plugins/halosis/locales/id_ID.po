msgstr "Pola baru"

msgid "Pattern updated"
msgstr "Pola diperbarui"

msgid "%d newly linked"
msgstr "%d baru ditautkan"

msgid "same category (%s)"
msgstr "kategori sama (%s)"

msgid "similar titles"
msgstr "judul mirip"

msgid "HaloSIS detected %1$d new tickets within the last %2$d minutes with %3$s."
msgstr "HaloSIS mendeteksi %1$d tiket baru dalam %2$d menit terakhir dengan %3$s."

msgid "Linked tickets:"
msgstr "Tiket yang ditautkan:"

msgid "Detected automatically. An officer decides the follow-up (investigate, assign a team, or close if unrelated)."
msgstr "Terdeteksi otomatis. Petugas memutuskan tindak lanjutnya (investigasi, tugaskan tim, atau tutup bila tidak berkaitan)."

msgid "Incident pattern detected"
msgstr "Pola insiden terdeteksi"

msgid "%d linked tickets"
msgstr "%d tiket tertaut"

msgid "Open the problem to decide the follow-up: investigate, assign a team, or close if unrelated."
msgstr "Buka Masalah ini untuk memutuskan tindak lanjut: investigasi, tugaskan tim, atau tutup bila tidak berkaitan."

msgid "Part of an incident pattern"
msgstr "Bagian dari pola insiden"

msgid "Minimum similar tickets"
msgstr "Jumlah minimal tiket serupa"

msgid "A pattern is created when at least this many new tickets share a category or have similar titles."
msgstr "Pola dibuat bila sedikitnya sejumlah ini tiket baru memiliki kategori yang sama atau judul yang mirip."

msgid "Time window (minutes)"
msgstr "Jendela waktu (menit)"

msgid "Tickets created within this window are checked. The scheduled task runs every 15 minutes."
msgstr "Tiket yang dibuat dalam jendela waktu ini akan diperiksa. Tugas terjadwal berjalan setiap 15 menit."

msgid "Operator group"
msgstr "Grup Operator"

msgid "Default (Operator Service Desk)"
msgstr "Bawaan (Operator Service Desk)"

msgid "The incident pattern problem is assigned to this group so Operators are notified and decide the follow-up."
msgstr "Masalah pola insiden ditugaskan ke grup ini agar Operator mendapat notifikasi dan memutuskan tindak lanjutnya."


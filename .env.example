# Contoh pengaturan lokal. Salin jadi .env (JANGAN commit .env):
#   Mac/Linux:  cp .env.example .env
#   Windows:    copy .env.example .env

# Database GLPI di docker-compose (hanya untuk laptop sendiri)
GLPI_DB_HOST=db
GLPI_DB_PORT=3306
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=glpi

# REST API GLPI untuk ai/scripts/build_index.py (artikel KB). Kosong = akun lokal glpi di http://localhost:8080;
# di server, isi GLPI_API_USER_TOKEN milik akun khusus baca (plus GLPI_API_APP_TOKEN bila diwajibkan).
GLPI_API_URL=
GLPI_API_USER=
GLPI_API_PASSWORD=
GLPI_API_USER_TOKEN=
GLPI_API_APP_TOKEN=

# Opsional: isi agar jawaban chatbot dirangkum Claude. Kosong = mode ekstraktif (gratis, tanpa internet).
ANTHROPIC_API_KEY=

# Model AI (pindah ke server AI BPS cukup ubah nilai ini). Kosong = bawaan: e5 lokal, LLM none (ekstraktif).
# Ganti model/dimensi embedding => layanan menolak indeks lama; jalankan ulang ai/scripts/build_index.py.
EMBEDDING_PROVIDER=       # local | openai (endpoint /v1/embeddings, awalan query:/passage: tetap)
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
LLM_PROVIDER=             # none | openai | anthropic
LLM_BASE_URL=             # Ollama (compose profile llm): http://ollama:11434/v1 ; Ollama native Mac: http://host.docker.internal:11434/v1
LLM_MODEL=                # mis. qwen2.5:3b
LLM_API_KEY=

# Login SSO Keycloak (dicek dari form login HaloSIS, tanpa halaman login Keycloak).
# Kosongkan HALOSIS_KEYCLOAK_URL untuk kembali ke login lokal GLPI. Nilai di bawah cocok dengan
# keycloak/halosis-realm.json (uji lokal); di server, pakai URL SSO BPS dan secret client yang sebenarnya.
HALOSIS_KEYCLOAK_URL=http://keycloak:8080
HALOSIS_KEYCLOAK_REALM=halosis
HALOSIS_KEYCLOAK_CLIENT_ID=halosis-glpi
HALOSIS_KEYCLOAK_CLIENT_SECRET=halosis-dev-secret

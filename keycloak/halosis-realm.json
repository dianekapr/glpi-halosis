{
  "realm": "halosis",
  "displayName": "SSO BPS (lokal HaloSIS)",
  "enabled": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
  "waitIncrementSeconds": 60,
  "roles": {
    "realm": [
      {
        "name": "pegawai",
        "description": "Pegawai BPS (Requester): profil GLPI Pegawai"
      },
      {
        "name": "operator",
        "description": "Operator HaloSIS: profil GLPI Operator"
      },
      {
        "name": "tim-teknis",
        "description": "Tim Teknis (Resolver): profil GLPI Tim Teknis"
      },
      {
        "name": "manajemen",
        "description": "Manajemen / Pimpinan: profil GLPI Manajemen"
      },
      {
        "name": "knowledge-manager",
        "description": "Knowledge Manager: profil GLPI Knowledge Manager"
      },
      {
        "name": "administrator",
        "description": "Administrator Sistem: profil GLPI Administrator"
      },
      {
        "name": "ketua-tim",
        "description": "Ketua tim: supervisor di grup timnya (penerima \"atasan\" peringatan risiko SLA)"
      }
    ]
  },
  "groups": [
    {
      "name": "Tim Aplikasi Statistik"
    },
    {
      "name": "Tim Jaringan"
    },
    {
      "name": "Tim Perangkat"
    },
    {
      "name": "Tim Identitas & Akses"
    },
    {
      "name": "Operator Service Desk"
    }
  ],
  "clients": [
    {
      "clientId": "halosis-glpi",
      "name": "HaloSIS (GLPI)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "halosis-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "halosis roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "halosis_roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "tim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
